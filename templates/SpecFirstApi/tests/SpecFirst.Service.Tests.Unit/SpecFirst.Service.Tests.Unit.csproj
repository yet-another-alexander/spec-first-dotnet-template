<Project Sdk="Microsoft.NET.Sdk">
  <!-- The implementer's own scaffolding: internals, edge cases, refactoring safety nets. No requirement ids, not
       protected, changed freely in implementation PRs. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
    <!-- The solution's own namespaces are global usings so that renaming the template never changes the
         alphabetical order CSharpier enforces on the using directives in each file. -->
    <Using Include="SpecFirst.Service.Api.Orders" />
    <Using Include="SpecFirst.Service.Models.Enums" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SpecFirst.Service.Api\SpecFirst.Service.Api.csproj" />
  </ItemGroup>
</Project>
