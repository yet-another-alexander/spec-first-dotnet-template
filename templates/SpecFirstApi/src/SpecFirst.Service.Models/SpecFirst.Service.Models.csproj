<Project Sdk="Microsoft.NET.Sdk">
  <!-- The synchronous contract: the request and response records and the wire enums of the HTTP API, nothing else.
       BCL only, so any client can take the package; docs/specs/api/openapi.yaml is the contract of record. -->
  <PropertyGroup>
    <Description>Request and response contracts of the SpecFirst.Service HTTP API.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- The solution's own namespaces are global usings so that renaming the template never changes the
         alphabetical order CSharpier enforces on the using directives in each file. -->
    <Using Include="SpecFirst.Service.Models.Enums" />
  </ItemGroup>
</Project>
